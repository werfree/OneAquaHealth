# Copy to .env when setting up a fresh checkout, then run: python run.py
# Private credentials belong in .env, not in this example or source control.

# Ingestion gateway and HTTP API.
APP_HOST=0.0.0.0
APP_PORT=8001
# HTTP ingestion, live dashboard and integrated Studio work without brokers.
# Set true only when your MQTT and RabbitMQ brokers are available.
INGESTION_WORKERS_ENABLED=false

# Integrated evidence dashboard: Overview, Ingestion and Surveillance Studio.
# Use 127.0.0.1 for this computer only; 0.0.0.0 also allows LAN access.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8090
OAH_LIVE_BASE_URL=http://127.0.0.1:8001
DASHBOARD_DEFAULT_THEME=aqua
# mock (fixtures) or live (reads the gateway above).
DASHBOARD_DEFAULT_MODE=live
OAH_LIVE_TIMEOUT_SECONDS=90

# FHIR transport and dataset scope.
FHIR_BASE_URL=https://hapi.fhir.org/baseR4
# false builds FHIR resources without uploading them.
FHIR_UPLOAD_ENABLED=true
OAH_DATASET_TAG=oah-demo

# Optional broker consumers (used when INGESTION_WORKERS_ENABLED=true).
# These RabbitMQ credentials are the included Docker Compose development defaults.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=oah
RABBITMQ_PASSWORD=oah-local-dev

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=oneaquahealth/sensors/+/+
# Choose a stable, unique client ID for each machine.
MQTT_CLIENT_ID=OAHIngest-your-machine
MQTT_USERNAME=
MQTT_PASSWORD=

# Required for natural-language Studio investigations and executive prose.
# Station reads, file ingestion and data exports do not require an OpenAI key.
OPENAI_API_KEY=

# Optional overrides; the values below are the application defaults.
# OPENAI_MODEL=gpt-4o
# FHIR_RETRIES=3
# FHIR_MAX_SEARCH_RESULTS=5000
# FHIR_MAX_PAGES=100
# OVERVIEW_CACHE_SECONDS=60
# OAH_BRIEFING_WORKERS=8
# MQTT_TLS=false
# MQTT_SESSION_EXPIRY_SECONDS=86400
# RABBITMQ_VHOST=/
# FHIR_RETRY_DELAY_SECONDS=5
# OAH_CITIES=coimbra,oslo,benevento,ghent,toulouse,delhi,kanpur,varanasi,mumbai,chennai,hyderabad
