# Copy to .env (gitignored) and fill in. Every value below is the default;
# the only one you must set is OPENAI_API_KEY -- unless you run against Ollama.

# --- model provider ----------------------------------------------------------
# LLM_PROVIDER=openai              # openai | ollama; inferred if unset
# LLM_MODEL=                       # generic fallback model for any provider

# OpenAI:
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=                 # only for a compatible gateway/proxy

# Ollama (local or self-hosted; the OpenAI SDK talks to it, so no extra deps):
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=deepseek-v4.1-flash:cloud
# OLLAMA_API_KEY=                  # only if your Ollama server requires one

# --- FHIR repository ---------------------------------------------------------
# FHIR_BASE_URL=https://hapi.fhir.org/baseR4
# FHIR_UPLOAD_ENABLED=true          # false runs everything except the POST
# OAH_DATASET_TAG=oah-demo          # scopes every query; the public sandbox
#                                   # also holds other parties' OAH resources

# --- ingestion ---------------------------------------------------------------
# APP_HOST=0.0.0.0
# APP_PORT=8000
# OAH_CITIES=delhi,kanpur,varanasi,mumbai,chennai,hyderabad
# OAH_SITES_FILE=demo/sites.json

# MQTT_HOST=broker.hivemq.com       # PUBLIC broker — use your own for an
# MQTT_PORT=1883                    # isolated demo; a wildcard subscription
# MQTT_TOPIC=oneaquahealth/sensors/+/+   # sees anyone else's traffic too

# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_USER=oah
# RABBITMQ_PASSWORD=oah-local-dev

# LOG_LEVEL=INFO
# LOG_LEVEL_PIKA=WARNING            # raise to debug broker problems

# --- separate evidence dashboard -----------------------------------------
# DASHBOARD_PORT=8090
# OAH_LIVE_BASE_URL=http://127.0.0.1:8000   # live-gateway mode (?mode=live)
# DASHBOARD_DEFAULT_THEME=aqua              # per-browser override wins
